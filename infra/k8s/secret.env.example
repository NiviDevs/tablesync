# Copy to infra/k8s/.local/secret.env (ignored), chmod 600, replace every placeholder.
# bootstrap.sh creates local random secrets when this file does not exist.
POSTGRES_PASSWORD=replace-with-random-hex
DATABASE_URL=postgresql://tablesync:replace-with-random-hex@postgres:5432/tablesync
RABBITMQ_DEFAULT_PASS=replace-with-random-hex
RABBITMQ_URL=amqp://tablesync:replace-with-random-hex@rabbitmq:5672
INTERNAL_API_SECRET=replace-with-at-least-32-random-bytes
GUEST_TOKEN_SECRET=replace-with-at-least-32-random-bytes
GRAFANA_ADMIN_PASSWORD=replace-with-random-hex
STAFF_JWT_ISSUER=
STAFF_JWT_AUDIENCE=authenticated
STAFF_JWKS_URL=
STAFF_ASSIGNMENTS_JSON={}
# Generated RSA JWK for local demo issuer; bootstrap creates this automatically.
DEMO_JWT_PRIVATE_JWK=
