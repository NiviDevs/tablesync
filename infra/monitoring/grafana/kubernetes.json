{
  "uid": "tablesync-kubernetes",
  "title": "TableSync / Kubernetes",
  "tags": [
    "tablesync",
    "local-minikube"
  ],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "query": "local-minikube",
        "current": {
          "text": "local-minikube",
          "value": "local-minikube"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Pod CPU (cores)",
      "description": "Environment: local-minikube. Real source samples; gaps indicate unavailable data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pod)(rate(container_cpu_usage_seconds_total{namespace=\"tablesync\",container!=\"\",container!=\"POD\"}[1m]))",
          "legendFormat": "{{service}}{{pod}}{{deployment}}{{condition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Pod memory (bytes)",
      "description": "Environment: local-minikube. Real source samples; gaps indicate unavailable data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pod)(container_memory_working_set_bytes{namespace=\"tablesync\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{service}}{{pod}}{{deployment}}{{condition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Desired replicas",
      "description": "Environment: local-minikube. Real source samples; gaps indicate unavailable data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_spec_replicas{namespace=\"tablesync\"}",
          "legendFormat": "{{service}}{{pod}}{{deployment}}{{condition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Ready replicas",
      "description": "Environment: local-minikube. Real source samples; gaps indicate unavailable data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"tablesync\"}",
          "legendFormat": "{{service}}{{pod}}{{deployment}}{{condition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
