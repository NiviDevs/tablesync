      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_spec_target_metric{namespace=\"tablesync\",metric_name=\"cpu\",metric_target_type=\"utilization\"}",
