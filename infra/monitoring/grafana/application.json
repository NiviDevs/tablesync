{
  "uid": "tablesync-application",
  "title": "TableSync / Application",
  "tags": [
    "tablesync",
    "local-minikube"
  ],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "timezone": "utc",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "query": "local-minikube",
        "current": {
          "text": "local-minikube",
          "value": "local-minikube"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (requests/s)",
      "description": "Environment: local-minikube. Real source samples; gaps indicate unavailable data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(rate(tablesync_http_requests_total[1m]))",
          "legendFormat": "{{service}}{{pod}}{{deployment}}{{condition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "p95 latency (seconds)",
      "description": "Environment: local-minikube. Real source samples; gaps indicate unavailable data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,service)(rate(tablesync_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{service}}{{pod}}{{deployment}}{{condition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "5xx fraction",
      "description": "Environment: local-minikube. Real source samples; gaps indicate unavailable data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(service)(rate(tablesync_http_requests_total{status_class=\"5xx\"}[1m])) or (0 * sum by(service)(rate(tablesync_http_requests_total[1m])))) / sum by(service)(rate(tablesync_http_requests_total[1m]))",
          "legendFormat": "{{service}}{{pod}}{{deployment}}{{condition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Active seating sessions",
      "description": "Environment: local-minikube. Real source samples; gaps indicate unavailable data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(tablesync_active_seating_sessions)",
          "legendFormat": "{{service}}{{pod}}{{deployment}}{{condition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Session count source available",
      "description": "Environment: local-minikube. Real source samples; gaps indicate unavailable data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(tablesync_active_seating_sessions_available)",
          "legendFormat": "{{service}}{{pod}}{{deployment}}{{condition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "RabbitMQ ready messages",
      "description": "Environment: local-minikube. Real source samples; gaps indicate unavailable data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rabbitmq_queue_messages_ready)",
          "legendFormat": "{{service}}{{pod}}{{deployment}}{{condition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "RabbitMQ unacknowledged messages",
      "description": "Environment: local-minikube. Real source samples; gaps indicate unavailable data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rabbitmq_queue_messages_unacked)",
          "legendFormat": "{{service}}{{pod}}{{deployment}}{{condition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Scrape reachability",
      "description": "Environment: local-minikube. Real source samples; gaps indicate unavailable data.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{service}}{{pod}}{{deployment}}{{condition}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
