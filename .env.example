# Local development only. Do not commit real credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# Server-side scripts and, after P4, the same-origin browser API proxy.
GATEWAY_URL=http://localhost:8080
# Generate separate random values locally (at least 32 bytes); server-only.
INTERNAL_API_SECRET=
GUEST_TOKEN_SECRET=
# Supabase issuer example: https://your-project.supabase.co/auth/v1
STAFF_JWT_ISSUER=
STAFF_JWT_AUDIENCE=authenticated
STAFF_JWKS_URL=
# Server-controlled subject map, e.g. {"subject-uuid":{"restaurantId":"00000000-0000-4000-8000-000000000001","roles":["staff"]}}
STAFF_ASSIGNMENTS_JSON={}
# Copy these public settings into apps/web/.env.local (the Next.js app root).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
DATABASE_URL=postgresql://tablesync:tablesync@localhost:5432/tablesync
# Service SQL only; Supabase keeps its separate migration history.
MIGRATIONS_DIR=infra/postgres/migrations
# Explicitly disposable database name required by migration integration tests.
TEST_DATABASE_URL=postgresql://tablesync:tablesync@localhost:5432/tablesync_test_foundation
# Set only after backing up and inspecting an existing service database:
# BASELINE_BACKUP_CONFIRMED=yes
